[TEMPLATE]
ENVIRONMENT=development
LOG_LEVEL=INFO
API_V1_STR=/api/v1
PROJECT_NAME=Verified

# x402 Payment Config
AVM_ADDRESS=YOUR_ADDRESS_HERE
FACILITATOR_URL=https://facilitator.goplausible.xyz
ALGORAND_NETWORK=algorand:SGO1GKSzyE7IEPItTxCByw9x8FmnrCDexi9/cOUJOiI=
SEMANTIC_REPAIR_PRICE=1000000

# Phase 15: Groq LLM Semantic Repair
# Set SEMANTIC_REPAIR_PROVIDER=groq and provide a valid GROQ_API_KEY
# to use real Groq LLM semantic repair instead of MockSemanticProvider.
# Obtain a key at: https://console.groq.com/keys
SEMANTIC_REPAIR_PROVIDER=groq
GROQ_API_KEY=gsk_YOUR_GROQ_API_KEY_HERE
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TIMEOUT_SECONDS=30
